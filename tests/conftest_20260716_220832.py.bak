    db_file = str(tmp_path / "test.db")
    monkeypatch.setenv("DB_PATH", db_file)
    from classroom_mcp.config import _settings

    _settings = None
    from classroom_mcp.database import clear_db_init_guard, close_db_pool, init_db

    await init_db()
    yield
    await close_db_pool()
    clear_db_init_guard()
