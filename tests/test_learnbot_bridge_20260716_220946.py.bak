"""Test the learnbot-mcp bridge — assignment_create_with_lesson.

Verifies:
  1. Graceful failure when learnbot is unreachable (no crash)
  2. Assignment is still created even if learnbot is down
  3. The URL path is correctly constructed
"""
from __future__ import annotations

import pytest


class TestLearnbotBridge:
    """assignment_create_with_lesson must handle learnbot being down gracefully."""

    @pytest.mark.asyncio
    async def test_assignment_created_even_if_learnbot_down(self, db, monkeypatch):
        from classroom_mcp.database import class_upsert, student_upsert, class_add_student
        from classroom_mcp.tools import assignment_create_with_lesson

        monkeypatch.setenv("LEARNBOT_URL", "http://127.0.0.1:11999")
        from classroom_mcp.config import _settings as _cfg

        _cfg = None

        cls = await class_upsert({"name": "Test Class"})
        cid = cls["class"]["id"]

        stu = await student_upsert({"name": "Test Student", "email": "s@t.at"})
        sid = stu["student"]["id"]
        await class_add_student(cid, sid)

        result = await assignment_create_with_lesson(
            class_id=cid,
            title="German A1 Test",
            description="Test assignment",
            level="A1",
            language="de",
        )
        assert result["success"] is True
        assert "generated_lesson" not in result

        from classroom_mcp.database import assignment_list

        assignments = await assignment_list(class_id=cid)
        assert len(assignments) >= 1
        assert assignments[-1]["lesson_id"] == 0

    @pytest.mark.asyncio
    async def test_url_path_is_correct(self):
        """Verify the URL path the bridge calls matches the learnbot-mcp endpoint."""
        from classroom_mcp.config import get_settings

        base = get_settings().learnbot_url.rstrip("/")
        expected = f"{base}/api/lessons/generate"
        assert "learnbot" in base.lower() or "11101" in base, (
            f"LEARNBOT_URL points to {base}, expected :11101"
        )
        assert expected.endswith("/api/lessons/generate")
