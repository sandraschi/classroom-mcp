        cur = await db.execute(
            "SELECT * FROM teaching_agents WHERE course_id=? AND active=1 ORDER BY role",
            (course_id,),
        )
        return [dict(r) for r in await cur.fetchall()]


async def agent_delete(agent_id: int) -> bool:
